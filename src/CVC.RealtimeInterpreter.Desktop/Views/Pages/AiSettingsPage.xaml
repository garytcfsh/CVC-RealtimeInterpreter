<Page
    x:Class="CVC.RealtimeInterpreter.Desktop.Views.Pages.AiSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ScrollViewer.CanContentScroll="False"
    Background="Transparent"
    Foreground="{DynamicResource WindowTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>
        <ui:InfoBar
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Message="{Binding ProviderNotice}"
            Margin="0,0,0,12" />
        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,12">
            <ui:TextBlock
                Text="{Binding SaveNotice}"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:TextBlock
                Text="{Binding Providers.Status}"
                TextWrapping="Wrap"
                Foreground="{DynamicResource WarningForeground}" />
        </StackPanel>
        <ui:TabView
            x:Name="AiTabs"
            IsEnabled="{Binding Providers.CanManage}"
            Grid.Row="2">
            <ui:TabViewItem
                Header="{Binding Providers.AssignmentsHeading}">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Style="{StaticResource UiScrollViewer}">
                    <StackPanel
                        Margin="0,12,8,16">
                        <ui:TextBlock
                            Text="{Binding Providers.AssignmentHelp}"
                            TextWrapping="Wrap"
                            Margin="0,0,0,12" />
                        <ItemsControl
                            x:Name="AssignmentRows"
                            ItemsSource="{Binding Providers.Assignments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card
                                        Padding="16"
                                        Margin="0,0,0,8">
                                        <StackPanel>
                                            <ui:TextBlock
                                                Text="{Binding Label}"
                                                FontTypography="BodyStrong"
                                                Margin="0,0,0,10" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition
                                                        Width="*" />
                                                    <ColumnDefinition
                                                        Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel
                                                    Margin="0,0,8,0">
                                                    <ui:TextBlock
                                                        Text="{Binding ProviderLabel}"
                                                        Margin="0,0,0,4" />
                                                    <ComboBox
                                                        MinWidth="0"
                                                        HorizontalAlignment="Stretch"
                                                        ItemsSource="{Binding Providers}"
                                                        DisplayMemberPath="Name"
                                                        SelectedItem="{Binding SelectedProvider}" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="8,0,0,0">
                                                    <ui:TextBlock
                                                        Text="{Binding ModelLabel}"
                                                        Margin="0,0,0,4" />
                                                    <ComboBox
                                                        MinWidth="0"
                                                        HorizontalAlignment="Stretch"
                                                        ItemsSource="{Binding Models}"
                                                        DisplayMemberPath="Id"
                                                        SelectedItem="{Binding SelectedModel}" />
                                                </StackPanel>
                                            </Grid>
                                            <ui:Button
                                                Content="{Binding ClearLabel}"
                                                Command="{Binding ClearCommand}"
                                                Margin="0,10,0,0" />
                                        </StackPanel>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:CardControl
                            Header="{Binding VoiceLabel}"
                            Icon="{ui:SymbolIcon Speaker224}"
                            Margin="0,8,0,8">
                            <ComboBox
                                x:Name="VoiceSelector"
                                ItemsSource="{Binding VoiceOptions}"
                                DisplayMemberPath="Label"
                                SelectedValuePath="Value"
                                SelectedValue="{Binding Voice}" />
                        </ui:CardControl>
                        <ui:CardControl
                            Header="{Binding StaleLabel}"
                            Icon="{ui:SymbolIcon Timer24}">
                            <ui:NumberBox
                                Width="190"
                                HorizontalAlignment="Right"
                                Minimum="1"
                                Maximum="300"
                                Value="{Binding StaleAudioSeconds}" />
                        </ui:CardControl>
                    </StackPanel>
                </ScrollViewer>
            </ui:TabViewItem>
            <ui:TabViewItem
                Header="{Binding Providers.Heading}">
                <ScrollViewer
                    x:Name="ProviderEditorScroller"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Style="{StaticResource UiScrollViewer}">
                    <StackPanel
                        DataContext="{Binding Providers}"
                        Margin="0,12,8,16">
                        <Grid
                            Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="ProviderSelector"
                                MinWidth="0"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{Binding Profiles}"
                                DisplayMemberPath="Name"
                                SelectedItem="{Binding SelectedProfile}"
                                Margin="0,0,12,0" />
                            <ui:Button
                                Grid.Column="1"
                                Content="{Binding AddLabel}"
                                Command="{Binding AddProviderCommand}" />
                        </Grid>
                        <ui:Card
                            Padding="16"
                            IsEnabled="{Binding IsEditable}"
                            Margin="0,0,0,12">
                            <StackPanel>
                                <ui:TextBlock
                                    Text="{Binding CapabilityTags}"
                                    FontTypography="BodyStrong"
                                    TextWrapping="Wrap"
                                    Margin="0,0,0,12" />
                                <ui:TextBlock
                                    Text="{Binding NameLabel}" />
                                <ui:TextBox
                                    x:Name="ProviderNameEditor"
                                    Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,4,0,10" />
                                <ui:TextBlock
                                    Text="{Binding ConnectionLabel}" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{Binding ConnectionTypes}"
                                    DisplayMemberPath="Label"
                                    SelectedValuePath="Value"
                                    SelectedValue="{Binding ConnectionType}"
                                    Margin="0,4,0,10" />
                                <ui:TextBlock
                                    Text="{Binding EndpointLabel}" />
                                <ui:TextBox
                                    x:Name="ProviderEndpointEditor"
                                    Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="https://…"
                                    Margin="0,4,0,10" />
                                <ui:TextBlock
                                    Text="{Binding ApiKeyLabel}" />
                                <ui:PasswordBox
                                    x:Name="ApiKeyEditor"
                                    PasswordChanged="ApiKeyEditor_PasswordChanged"
                                    Margin="0,4,0,8" />
                                <ui:TextBlock
                                    Text="{Binding KeyStatus}"
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Margin="0,0,0,8" />
                                <WrapPanel>
                                    <ui:Button
                                        Content="{Binding RemoveKeyLabel}"
                                        Click="RemoveKey_Click"
                                        Margin="0,0,8,0" />
                                    <ui:Button
                                        Content="{Binding DeleteLabel}"
                                        Command="{Binding DeleteProviderCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </ui:Card>
                        <ui:Card
                            Padding="16"
                            IsEnabled="{Binding IsEditable}">
                            <StackPanel>
                                <ui:TextBlock
                                    Text="{Binding ModelsLabel}"
                                    FontTypography="BodyStrong"
                                    Margin="0,0,0,8" />
                                <ComboBox
                                    x:Name="ConfiguredModelSelector"
                                    MinWidth="0"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{Binding ConfiguredModels}"
                                    SelectedItem="{Binding SelectedConfiguredModel}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <ui:TextBlock
                                                    Text="{Binding Id}" />
                                                <ui:TextBlock
                                                    Text="{Binding Capabilities}"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ui:Button
                                    Content="{Binding RemoveModelLabel}"
                                    Command="{Binding RemoveModelCommand}"
                                    Margin="0,8,0,12" />
                                <ui:TextBlock
                                    Text="{Binding ModelIdLabel}" />
                                <ui:TextBox
                                    Text="{Binding NewModelId, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,4,0,8" />
                                <WrapPanel>
                                    <CheckBox
                                        Content="STT"
                                        IsChecked="{Binding ModelStt}"
                                        Margin="0,0,16,8" />
                                    <CheckBox
                                        Content="{Binding TranslationLabel}"
                                        IsChecked="{Binding ModelTranslation}"
                                        Margin="0,0,16,8" />
                                    <CheckBox
                                        Content="{Binding SpeechLabel}"
                                        IsChecked="{Binding ModelSpeech}"
                                        Margin="0,0,0,8" />
                                </WrapPanel>
                                <CheckBox
                                    Content="{Binding StreamingLabel}"
                                    IsChecked="{Binding ModelStreaming}"
                                    Margin="0,0,0,8" />
                                <ui:TextBlock
                                    Text="{Binding ModelHelp}"
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Margin="0,0,0,12" />
                                <ui:Button
                                    Content="{Binding AddModelLabel}"
                                    Command="{Binding AddModelCommand}" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </ui:TabViewItem>
        </ui:TabView>
    </Grid>
</Page>
