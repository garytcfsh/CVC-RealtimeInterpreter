<Page
    x:Class="CVC.RealtimeInterpreter.Desktop.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    Foreground="{DynamicResource WindowTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>
        <ui:InfoBar
            Grid.Row="0"
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Message="{Binding PreviewNotice}"
            Margin="0,0,0,20" />
        <StackPanel
            Grid.Row="1">
            <WrapPanel
                Margin="0,0,0,12">
                <ui:TextBlock
                    Text="{Binding ModeLabel}"
                    VerticalAlignment="Center"
                    Margin="0,0,16,0" />
                <RadioButton
                    Content="{Binding StageOneLabel}"
                    IsChecked="True"
                    IsEnabled="False"
                    GroupName="SessionMode" />
                <RadioButton
                    Content="{Binding StageTwoLabel}"
                    IsEnabled="False"
                    GroupName="SessionMode" />
                <ui:Button
                    Content="{Binding StartLabel}"
                    Appearance="Primary"
                    Command="{Binding StartAudioCommand}"
                    Margin="0,0,8,0" />
                <ui:Button
                    Content="{Binding StopLabel}"
                    Command="{Binding StopAudioCommand}" />
            </WrapPanel>
            <ui:TextBlock
                Text="{Binding AudioStatus}"
                TextWrapping="Wrap"
                Margin="0,0,0,12" />
            <Border
                Background="{DynamicResource PreviewBackground}"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
                <StackPanel>
                    <Grid
                        Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="Auto" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            Text="{Binding InputLevelLabel}"
                            Margin="0,0,16,0" />
                        <ui:TextBlock
                            Grid.Column="1"
                            Text="{Binding InputSignalStatus}"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar
                        x:Name="InputLevelMeter"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding InputLevel}"
                        IsIndeterminate="False"
                        Height="8" />
                </StackPanel>
            </Border>
            <WrapPanel
                Margin="0,0,0,20">
                <ui:Button
                    Content="{Binding PreviewButton}"
                    Appearance="Primary"
                    Command="{Binding LoadPreviewCommand}"
                    Margin="0,0,8,8" />
                <ui:Button
                    Content="{Binding ClearButton}"
                    Command="{Binding ClearPreviewCommand}"
                    Margin="0,0,8,8" />
                <ui:Button
                    Content="{Binding ReturnToLiveLabel}"
                    Click="ReturnToLive_Click"
                    Margin="0,0,0,8" />
            </WrapPanel>
        </StackPanel>
        <Grid
            Grid.Row="2"
            Margin="16,0,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock
                Text="中文 · 繁體"
                FontTypography="BodyStrong" />
            <ui:TextBlock
                Grid.Column="1"
                Text="English"
                Margin="16,0,0,0"
                FontTypography="BodyStrong" />
        </Grid>
        <ScrollViewer
            x:Name="TranscriptScroller"
            Grid.Row="3"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            Style="{StaticResource UiScrollViewer}">
            <ItemsControl
                ItemsSource="{Binding Segments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="16"
                            Margin="0,0,0,12"
                            CornerRadius="8">
                            <Border.Style>
                                <Style
                                    TargetType="Border">
                                    <Setter
                                        Property="Background"
                                        Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsCurrent}"
                                            Value="True">
                                            <Setter
                                                Property="Background"
                                                Value="{DynamicResource CurrentSentenceBackground}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock
                                    Text="{Binding Mandarin}"
                                    TextWrapping="Wrap"
                                    Margin="0,0,16,0"
                                    FontSize="{Binding DataContext.TranscriptFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <ui:TextBlock.Style>
                                        <Style
                                            TargetType="ui:TextBlock">
                                            <Setter
                                                Property="Foreground"
                                                Value="{DynamicResource WindowTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding MandarinLowConfidence}"
                                                    Value="True">
                                                    <Setter
                                                        Property="Foreground"
                                                        Value="{DynamicResource WarningForeground}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:TextBlock.Style>
                                </ui:TextBlock>
                                <ui:TextBlock
                                    Grid.Column="1"
                                    Text="{Binding English}"
                                    TextWrapping="Wrap"
                                    Margin="16,0,0,0"
                                    FontSize="{Binding DataContext.TranscriptFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <ui:TextBlock.Style>
                                        <Style
                                            TargetType="ui:TextBlock">
                                            <Setter
                                                Property="Foreground"
                                                Value="{DynamicResource WindowTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding EnglishLowConfidence}"
                                                    Value="True">
                                                    <Setter
                                                        Property="Foreground"
                                                        Value="{DynamicResource WarningForeground}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:TextBlock.Style>
                                </ui:TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <ui:TextBlock
            Grid.Row="3"
            Text="{Binding EmptyNotice}"
            TextWrapping="Wrap"
            Margin="16"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <ui:TextBlock.Style>
                <Style
                    TargetType="ui:TextBlock">
                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding Segments.Count}"
                            Value="0">
                            <Setter
                                Property="Visibility"
                                Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:TextBlock.Style>
        </ui:TextBlock>
    </Grid>
</Page>
