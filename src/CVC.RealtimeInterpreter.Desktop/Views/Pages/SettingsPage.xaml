<Page
    x:Class="CVC.RealtimeInterpreter.Desktop.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    Foreground="{DynamicResource WindowTextBrush}">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Style="{StaticResource UiScrollViewer}">
        <StackPanel
            Margin="0,0,8,16">
            <ui:TextBlock
                Text="{Binding SaveNotice}"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Margin="0,0,0,20" />
            <ui:CardControl
                Header="{Binding ThemeLabel}"
                Icon="{ui:SymbolIcon Color24}"
                Margin="0,0,0,8">
                <ComboBox
                    x:Name="ThemeSelector"
                    ItemsSource="{Binding ThemeOptions}"
                    DisplayMemberPath="Label"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding Theme}" />
            </ui:CardControl>
            <ui:CardControl
                Header="{Binding LanguageLabel}"
                Icon="{ui:SymbolIcon LocalLanguage24}"
                Margin="0,0,0,8">
                <ComboBox
                    x:Name="LanguageSelector"
                    ItemsSource="{Binding LanguageOptions}"
                    DisplayMemberPath="Label"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding Language}" />
            </ui:CardControl>
            <ui:CardControl
                Header="{Binding TextSizeLabel}"
                Icon="{ui:SymbolIcon TextFont24}"
                Margin="0,0,0,8">
                <StackPanel
                    Width="200">
                    <Slider
                        Minimum="14"
                        Maximum="48"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding TranscriptFontSize}" />
                    <ui:TextBlock
                        Text="{Binding TranscriptFontSize, StringFormat={}{0:0} px}"
                        HorizontalAlignment="Right"
                        Margin="0,4,0,0" />
                </StackPanel>
            </ui:CardControl>
            <ui:Card
                Padding="20"
                Margin="0,0,0,8">
                <StackPanel>
                    <ui:TextBlock
                        Text="{Binding InputLabel}"
                        FontTypography="BodyStrong" />
                    <Grid
                        Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="AudioInputSelector"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding InputDevices}"
                            DisplayMemberPath="Name"
                            SelectedItem="{Binding SelectedInputDevice}"
                            IsEnabled="{Binding CanChangeInput}"
                            Margin="0,0,12,0" />
                        <ui:Button
                            Grid.Column="1"
                            Content="{Binding RefreshInputsLabel}"
                            Command="{Binding RefreshInputsCommand}" />
                    </Grid>
                    <ui:TextBlock
                        Text="{Binding AudioStatus}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,8" />
                    <ui:TextBlock
                        Text="{Binding InputHelp}"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:Card>
            <ui:Card
                Padding="20"
                Margin="0,0,0,16">
                <StackPanel>
                    <ui:TextBlock
                        Text="{Binding StorageLabel}"
                        FontTypography="BodyStrong" />
                    <ui:TextBlock
                        Text="{Binding DataDirectory}"
                        TextWrapping="Wrap"
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
