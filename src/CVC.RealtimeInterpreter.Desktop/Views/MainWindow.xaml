<ui:FluentWindow
    x:Class="CVC.RealtimeInterpreter.Desktop.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="clr-namespace:CVC.RealtimeInterpreter.Desktop.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="CVC-RealtimeInterpreter"
    Width="1280"
    Height="850"
    MinWidth="900"
    MinHeight="620"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource WindowSurfaceBrush}"
    Foreground="{DynamicResource WindowTextBrush}"
    FontFamily="Segoe UI">
    <Grid
        Background="{DynamicResource WindowSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="40" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>
        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            SelectionChanged="Navigation_SelectionChanged"
            PaneDisplayMode="Left"
            IsPaneOpen="True"
            OpenPaneLength="220"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            IsTopSeparatorVisible="False"
            IsFooterSeparatorVisible="False"
            FrameMargin="0"
            Padding="24,0,24,24"
            Transition="None">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    x:Name="HomeNavigationItem"
                    Content="{Binding HomeLabel}"
                    Icon="{ui:SymbolIcon Home24}"
                    TargetPageType="{x:Type pages:HomePage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    x:Name="SettingsNavigationItem"
                    Content="{Binding SettingsTitle}"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem
                            x:Name="AiNavigationItem"
                            Content="{Binding AiLabel}"
                            TargetPageType="{x:Type pages:AiSettingsPage}" />
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.Header>
                <StackPanel
                    Margin="24,20,24,16">
                    <ui:TextBlock
                        Text="{Binding CurrentPageTitle}"
                        FontTypography="Title"
                        Foreground="{DynamicResource WindowTextBrush}" />
                    <ui:TextBlock
                        Text="{Binding SettingsStatus}"
                        Foreground="{DynamicResource WarningForeground}"
                        Margin="0,8,0,0"
                        TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Assertive">
                        <ui:TextBlock.Style>
                            <Style
                                TargetType="ui:TextBlock">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding SettingsStatus}"
                                        Value="">
                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:TextBlock.Style>
                    </ui:TextBlock>
                </StackPanel>
            </ui:NavigationView.Header>
        </ui:NavigationView>
        <ui:TitleBar
            x:Name="ApplicationTitleBar"
            Grid.Row="0"
            Panel.ZIndex="10"
            Title="CVC-RealtimeInterpreter"
            Foreground="{DynamicResource WindowTextBrush}"
            ButtonsForeground="{DynamicResource WindowTextBrush}"
            Background="{DynamicResource WindowSurfaceBrush}"
            Height="40"
            ShowMinimize="True"
            ShowMaximize="True"
            ShowClose="True"
            ForceShutdown="False" />
    </Grid>
</ui:FluentWindow>
